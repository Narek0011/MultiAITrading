<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">{{t.features.eyebrow}}</span>
      <h2>{{t.features.title}}</h2>
    </div>
    <div class="features">
      {{#each t.features.items}}
      <article class="feature glass reveal"><span class="feature-icon">{{icon icon}}</span><h3>{{title}}</h3><p>{{text}}</p></article>
      {{/each}}
    </div>
  </div>
</section>
