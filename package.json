{
  "name": "multiaitrading",
  "version": "1.0.0",
  "private": true,
  "description": "MultiAITrading — AI forex signals bot for Telegram with landing page and admin panel",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "geoip-country": "^5.0.202610240156",
    "hbs": "^4.4.0",
    "jpeg-js": "^0.4.4",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "technicalindicators": "^3.1.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9"
  }
}
