<section class="live" aria-label="{{t.proof.eyebrow}}">
  <div class="ticker" aria-hidden="true">
    <div class="ticker-beam"></div>
    <div class="ticker-track">
      {{#each pairs}}<span class="tick"><i></i>{{symbol}}</span>{{/each}}
      {{#each pairs}}<span class="tick"><i></i>{{symbol}}</span>{{/each}}
    </div>
  </div>
  <div class="container">
    {{#if proof.any}}
    <div class="live-head reveal">
      <span class="eyebrow">{{t.proof.eyebrow}}</span>
      <h2>{{t.proof.title}}</h2>
    </div>
    {{/if}}
    <div class="live-stats">
      {{#if proof.expiry}}<div class="stat reveal"><b data-count="{{proof.expiry.winRate}}" data-suffix="%">{{proof.expiry.winRate}}%</b><span>{{t.proof.expiryWin}}</span><small>{{proof.expiry.wins}} / {{proof.expiry.total}}</small></div>{{/if}}
      {{#if proof.forex}}<div class="stat reveal"><b data-count="{{proof.forex.winRate}}" data-suffix="%">{{proof.forex.winRate}}%</b><span>{{t.proof.forexWin}}</span><small>{{proof.forex.wins}} / {{proof.forex.total}}</small></div>{{/if}}
      {{#if proof.any}}
      <div class="stat reveal"><b data-count="{{proof.closed30}}">{{proof.closed30}}</b><span>{{t.proof.closed}}</span></div>
      {{#if proof.bestStreak}}<div class="stat reveal"><b data-count="{{proof.bestStreak}}">{{proof.bestStreak}}</b><span>{{t.proof.streak}}</span></div>{{/if}}
      {{else}}
      <div class="stat reveal"><b data-count="{{status.pairsMonitored}}" data-live="pairsMonitored">{{status.pairsMonitored}}</b><span>{{t.proof.pairs}}</span></div>
      <div class="stat reveal"><b data-count="{{status.analysesToday}}" data-live="analysesToday">{{status.analysesToday}}</b><span>{{t.proof.analyses}}</span></div>
      {{/if}}
    </div>
    {{#if proof.any}}<p class="live-note reveal">{{t.proof.note}}</p>{{/if}}
  </div>
</section>
