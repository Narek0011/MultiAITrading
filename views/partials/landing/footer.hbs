<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <a href="/" class="footer-logo" aria-label="MultiAI Trading"><img src="/static/img/logo-full.png" alt="MultiAI Trading" width="146" height="128" /></a>
      <div class="footer-links">
        <a href="{{signalsUrl}}" target="_blank" rel="noopener">{{icon "telegram"}} Signals</a>
        <a href="{{supportUrl}}" target="_blank" rel="noopener">{{icon "telegram"}} Support</a>
        {{#if newsUrl}}<a href="{{newsUrl}}" target="_blank" rel="noopener">{{icon "telegram"}} {{t.news.short}}</a>{{/if}}
      </div>
    </div>
    <p class="disclaimer">{{t.footer.disclaimer}}</p>
    <p class="copy">© {{year}} MultiAI Trading. {{t.footer.rights}} · <a href="/terms?lang={{lang}}">{{legal.termsLink}}</a> · <a href="/privacy?lang={{lang}}">{{legal.privacyLink}}</a></p>
  </div>
</footer>
