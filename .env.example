# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multiaitrading

# Admin login (seeded on first start; change password later by updating this and restarting)
ADMIN_EMAIL=admin@multiaitrading.com
ADMIN_PASSWORD=change-me-now
JWT_SECRET=replace-with-a-long-random-string

# Everything else (OpenAI key, Twelve Data key, Telegram bot token, channel, URLs, strategy)
# is configured from /admin and stored in the database.
